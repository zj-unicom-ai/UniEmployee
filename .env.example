# ===== 模型配置（OpenAI 兼容协议）=====
# DeepSeek 官方端点示例：
MODEL_NAME=openai:deepseek-chat
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_API_KEY=sk-your-key-here

# ===== 安全（JWT）=====
# 必须改成随机长字符串（建议 >= 32 字节，可用 `openssl rand -hex 32` 生成）。
# 改了之后所有已签发的 token 立即失效，需要重新登录。
JWT_SECRET=change-me-to-a-long-random-secret
# token 有效期（小时），默认 24
JWT_EXPIRE_HOURS=24

# ===== 运行 / 运维 =====
# 日志级别：DEBUG / INFO / WARNING / ERROR，默认 INFO
LOG_LEVEL=INFO
# 可选：日志同时写文件（留空则只打控制台）。容器里通常配合卷挂载。
# LOG_FILE=/app/logs/app.log
# SQLite 数据目录；容器部署挂载卷后改为 /app/data。本地留空=项目根。
# APP_DATA_DIR=/app/data
# 版本号（/health 与日志会打印），便于多实例时定位。
APP_VERSION=0.9.0

# ===== 数据库后端 =====
# postgres（默认）：连接 PostgreSQL，每个业务库一个 database（catalog/conversations/
#   checkpoints/store/traces/approvals/ontology），表结构由应用启动时自动创建。
#
# 快速起一套 PostgreSQL（docker）：
#   docker compose up -d db     # 首次启动自动建好 7 个业务库
# 已有 PG 实例时改用幂等建库脚本：
#   ./scripts/init_postgres.sh
#
# sqlite：仅测试夹具内部使用（tests/conftest.py 强制 sqlite 跑临时库），
# 生产/开发部署不再走 SQLite。
DB_BACKEND=postgres
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=uniemployee
POSTGRES_PASSWORD=change-me
# 库名前缀（多套环境共用一个 PG 实例时用，如 dev_）
POSTGRES_DB_PREFIX=

# ===== RAGFlow 知识库接入 =====
# 本地 RAGFlow 部署后，在 UI 的 API Key 页面创建 key；数据集 id 在知识库 URL/API 中获取。
RAGFLOW_BASE_URL=http://localhost
RAGFLOW_API_KEY=ragflow-your-api-key
# 逗号分隔的 dataset id；留空则检索该 key 可见的全部 dataset。
RAGFLOW_DATASET_IDS=
