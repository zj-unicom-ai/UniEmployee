# ===== 模型配置（OpenAI 兼容协议）=====
# DeepSeek 官方端点示例：
MODEL_NAME=openai:deepseek-chat
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_API_KEY=sk-your-key-here

# ===== 安全（JWT）=====
# 必须改成随机长字符串（建议 >= 32 字节，可用 `openssl rand -hex 32` 生成）。
# 改了之后所有已签发的 token 立即失效，需要重新登录。
JWT_SECRET=change-me-to-a-long-random-secret
# token 有效期（小时），默认 24
JWT_EXPIRE_HOURS=24

# ===== 外部 IM 凭证加密 =====
# 飞书等频道启用前必须配置，且必须与 JWT_SECRET 不同。
# 生成示例：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
IM_CREDENTIAL_KEY=replace-with-a-dedicated-fernet-key
# 飞书长连接总开关；G0-G4 验收完成前保持关闭。
FEISHU_ENABLED=0
# FEISHU_ENABLED=1 时必填；长连接模式不需要公网 HTTPS 回调地址。
# FEISHU_APP_ID=
# FEISHU_APP_SECRET=
# FEISHU_TENANT_KEY=可选；通常由首个事件自动识别
# FEISHU_CHANNEL_ID=feishu
# FEISHU_EMPLOYEE_ID=

# IM 发件箱可靠重试：指数退避，超过次数进入 Dead Letter，可在管理页手工重放。
IM_OUTBOX_MAX_ATTEMPTS=5
IM_OUTBOX_RETRY_BASE_SECONDS=2
IM_OUTBOX_RETRY_MAX_SECONDS=300

# 员工执行期间的「已收到，正在处理」提示（飞书/钉钉通用，默认开启）。
# 卡片可用时该反馈由卡片承担，不会再单独发这条消息。
# IM_PROGRESS_NOTICE=1

# 等待态：给用户那条消息加一个 Typing 表情回应，处理完自动移除（飞书已实现）。
# 它比任何提示消息都早、且不占消息位、不会留下"已收到"这类永久停留的消息。
# 需要 im:message.reaction 权限；缺权限或接口失败时静默跳过，不影响正式回复。
# IM_TYPING_REACTION=1

# ===== 钉钉 AI 卡片 =====
# 卡片把「一次回复」表达为一张会原地演进的卡片（处理中 -> 流式 -> 完成），
# 替代「已收到 + 结果」两条独立文本。需要应用具备 Card.Instance.Write 与
# Card.Streaming.Write 权限，并在卡片平台建好「AI 卡片」模板。
# 模板 ID 留空 = 卡片不可用，自动退回文本回复（不会发空卡片）。
# DINGTALK_CARD_TEMPLATE_ID=b7e41795-xxxx-xxxx-xxxx-xxxxxxxxxxxx.schema
# 节流档位，直接决定一次回复的接口调用量：
#   stream   真流式：0.4s 一次、不限次数（≈2.5 次/秒）。飞书的默认档
#   staged   阶段式：约 4~7 次/回复。钉钉的默认档（入站额度要省）
#   two_state 两态，只投放与收尾各一次
# 注意 stream 的「不限次数」不是无限跑：速率由 0.4s 的最小间隔兜住，仍在飞书
# 「单卡片 10 次/秒」之内。飞书流式更新模式本身不计 QPS 配额，所以这里放开上限
# 没有额外代价 —— 反而是必须的：有上限时回复后半段会停止推送，收尾再把攒下的
# 内容一次性甩上屏，观感就是「打几个字 → 卡住 → 一大段突然蹦出来」。
#
# ⚠ IM_CARD_LEVEL 是**全局值，会覆盖所有渠道的默认档**。飞书与钉钉的代价结构
#   不同（飞书不计 QPS，钉钉要省入站额度），渠道默认已分别是 stream / staged。
#   一旦设了全局值，CHANNEL_DEFAULT_LEVELS 就整段失效 —— 而且表面看不出异常。
#   所以：要么不设这行，要么像下面那样分开指定。
# IM_CARD_LEVEL=staged
# 渠道级覆盖：优先于上面的全局值。只想改一个渠道时用它。
# IM_CARD_LEVEL_FEISHU=stream
# 卡片总开关：置 0/false/no/off 可整体退回文本回复。
# IM_CARD_ENABLED=1
# 正文超过 3000 字符时卡片会截断，并另发一条文本消息补全（避免丢结果）。
# 该上限写在 backend/app/im/cards/__init__.py 的 MAX_CARD_CONTENT_CHARS。
#
# 飞书卡片不需要模板，也不需要额外配置：卡片 JSON 在代码里构造，权限只需
# cardkit:card:write（"创建与更新卡片"）。飞书侧**不做**正文截断 —— 实测
# 15000 字符、88KB 卡 JSON 均正常。参见 docs/飞书流式与等待回复调研.md。
# 飞书打字机速率（可选）：上屏速率 = print_step / print_frequency_ms。
# **必须 ≥ 模型产出速率**，否则每次推送都要把积压"追赶"上屏，观感就是
# 「打几个字 → 蹦出一段」。真机实测本项目的模型约 130~300 字/秒
# （见 data/db/traces.db 的 llm 事件：425 字 / 2.07s），所以默认取
# 8 字 / 20ms = 400 字/秒，留一倍余量。模型明显更快时再调大：
#   IM_FEISHU_PRINT_STEP 每 +1 ≈ +50 字/秒（频率保持 20ms）
# 注意飞书要求两个字段**必须成对出现**，只给一个会报 11311。
# IM_FEISHU_PRINT_FREQUENCY_MS=20
# IM_FEISHU_PRINT_STEP=8

# ===== 企业 SSO（OIDC，可选）=====
# 三项均配置后，登录页会显示“企业单点登录”；生产环境必须 AUTH_COOKIE_SECURE=1。
ENTERPRISE_TENANT_ID=default
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=
# OIDC_GROUPS_CLAIM=groups
# OIDC_ORG_CLAIM=department
# OIDC_GROUP_ROLE_MAP={"ai-platform-admins":"admin"}
# OIDC_ORG_MAP={"HZ-ENT":"org_hangzhou_enterprise"}
AUTH_COOKIE_SECURE=0

# ===== 初始管理员（仅空库首次启动创建；之后绝不重置已有账号）=====
# 保持默认密码 admin123 时，首次登录会强制修改密码
# ADMIN_USER=admin
# ADMIN_PASS=admin123

# ===== 联网搜索（bocha_search 工具依赖，缺失时该工具报错）=====
# BOCHA_API_KEY=

# ===== 运行 / 运维 =====
# 日志级别：DEBUG / INFO / WARNING / ERROR，默认 INFO
LOG_LEVEL=INFO
# 可选：日志同时写文件（留空则只打控制台）。容器里通常配合卷挂载。
# LOG_FILE=/app/logs/app.log
# SQLite 数据目录；容器部署挂载卷后改为 /app/data。本地留空=项目根。
# APP_DATA_DIR=/app/data
# 版本号（/health 与日志会打印），便于多实例时定位。
APP_VERSION=0.19.0

# ===== 数据库后端 =====
# postgres（默认）：连接 PostgreSQL，每个业务库一个 database（catalog/conversations/
#   checkpoints/store/traces/approvals/ontology），表结构由应用启动时自动创建。
#
# 快速起一套 PostgreSQL（docker）：
#   docker compose up -d db     # 首次启动自动建好 7 个业务库
# 已有 PG 实例时改用幂等建库脚本：
#   ./scripts/init_postgres.sh
#
# sqlite：仅测试夹具内部使用（tests/conftest.py 强制 sqlite 跑临时库），
# 生产/开发部署不再走 SQLite。
DB_BACKEND=postgres
POSTGRES_HOST=127.0.0.1
# 宿主机端口；Compose 容器之间仍使用 db:5432。
POSTGRES_PORT=15432
POSTGRES_USER=uniemployee
POSTGRES_PASSWORD=change-me
# 库名前缀（多套环境共用一个 PG 实例时用，如 dev_）
POSTGRES_DB_PREFIX=

# ===== RAGFlow 知识库接入 =====
# 本地 RAGFlow 部署后，在 UI 的 API Key 页面创建 key；数据集 id 在知识库 URL/API 中获取。
RAGFLOW_BASE_URL=http://localhost
RAGFLOW_API_KEY=ragflow-your-api-key
# 逗号分隔的 dataset id；留空则检索该 key 可见的全部 dataset。
RAGFLOW_DATASET_IDS=

# ===== OpenSandbox 沙箱执行环境 =====
# 总开关：置 1 后 backend=sandbox 的员工（execute/文件工具）在沙箱容器内执行；
# 留空/0 时回退宿主机 LocalShellBackend（测试与未部署 server 的环境）。
# SANDBOX_ENABLED=1
# server 地址（本地裸跑默认 localhost:8090；app 也跑容器时用 opensandbox-server:8090）
SANDBOX_DOMAIN=localhost:8090
SANDBOX_PROTOCOL=http
# server 配置了 api_key 时填写（生产建议开启，去掉 server 的 OPENSANDBOX_INSECURE_SERVER）
# SANDBOX_API_KEY=
# 沙箱镜像（需预装 pandas/duckdb/matplotlib/openpyxl/python-docx，见 sandbox/image/Dockerfile）
SANDBOX_IMAGE=uniemployee/sandbox:py312-data
# **docker 宿主机**上数据目录的绝对路径（server 通过 docker.sock 挂载，按容器外路径解析）：
#   SANDBOX_HOST_DATA     = workspace/data 的宿主机路径（按用户 subPath 读写挂到沙箱 /data）
#   SANDBOX_HOST_DATASETS = workspace/datasets 的宿主机路径（共享数据集，只读挂到 /datasets）
# 同时需在 server config.toml 的 [storage] allowed_host_paths 放行这两个前缀。
# SANDBOX_HOST_DATA=/Users/wrg/Important/UniEmployee/workspace/data
# SANDBOX_HOST_DATASETS=/Users/wrg/Important/UniEmployee/workspace/datasets
# 沙箱空闲 TTL（分钟，到期 server 自动回收）与单命令超时（秒）
SANDBOX_TTL_MINUTES=30
SANDBOX_CMD_TIMEOUT=1800
# 单沙箱资源上限
SANDBOX_CPU=1
SANDBOX_MEMORY=2Gi
# 单进程并发沙箱上限（按会话计；超限抛错，避免容器数失控）
SANDBOX_MAX_CONCURRENT=20

# ===== Playwright 浏览器连接器 =====
# 连接器配置在 seeds.py 的 CONNECTOR_SEEDS 里（npx @playwright/mcp，headless + isolated）。
# 首次使用前需安装浏览器二进制（仅一次）：
#   npx playwright install --with-deps chromium
# 容器部署时在 Dockerfile 里加这行（RUN npx playwright install --with-deps chromium）。
# 浏览器自动化需要额外系统依赖（libnss3/libatk1.0/libgbm 等），Debian/Ubuntu 用
#   npx playwright install-deps chromium  自动装齐。

# ===== 运行时开关与限额（默认值即可满足大多数部署）=====
# 置 1 跳过全部 MCP 连接器初始化（连接器故障排障时的保险开关）
# MCP_DISABLED=1
# 置 1 跳过自动化任务调度器（cron 不再触发；事件入口仍可用）
# AUTOMATIONS_DISABLED=1
# 市场简报发布外推：publish_briefing 经人工批准后 POST 到该地址（群机器人 webhook 等）
# MARKET_INTEL_PUBLISH_WEBHOOK=
# 会话附件上传上限（字节），默认 20MB
# MAX_ATTACHMENT_SIZE=20971520
# 审批单：单用户待审批上限 / 过期时间（秒），默认 100 / 86400
# APPROVAL_PENDING_LIMIT=100
# APPROVAL_TTL_SECONDS=86400
# 服务启动时会话恢复上限，默认 2000
# CONV_RECOVER_LIMIT=2000
# run_python 单次代码长度/输出截断（字符），默认 20000 / 6000
# RUN_PYTHON_MAX_CODE_LEN=20000
# RUN_PYTHON_MAX_OUTPUT_LEN=6000
# 数据分析员工 SQL 服务端超时（秒）/ 返回行数上限，默认 30 / 1000
# ANALYST_QUERY_TIMEOUT_SEC=30
# ANALYST_QUERY_MAX_ROWS=1000
